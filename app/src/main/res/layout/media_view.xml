<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Images -->
    <com.github.panpf.zoomimage.GlideZoomImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:disabledScrollBar="true" />

    <!-- Video -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:show_rewind_button="true"
        app:show_fastforward_button="true"
        app:show_next_button="false"
        app:show_previous_button="false"
        app:show_shuffle_button="false"
        app:show_subtitle_button="true"
        app:show_timeout="0" />

    <ImageButton
        android:id="@+id/fullscreenButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/video_fullscreen"
        android:padding="8dp"
        android:src="@drawable/ic_fullscreen_enter"
        android:tint="@android:color/white"
        android:visibility="gone" />

</FrameLayout>
